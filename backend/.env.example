# ============================================================
# FinanceFlow - Variáveis de Ambiente (Backend)
# Copie este arquivo para `.env`:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/Mac:            cp .env.example .env
# ============================================================

# Banco de dados LOCAL em arquivo (SQLite) - não precisa de Docker nem servidor.
# O arquivo é criado em backend/prisma/dev.db automaticamente pelas migrations.
DATABASE_URL="file:./dev.db"

# Chave secreta usada para assinar os tokens JWT (autenticação).
# Em produção, troque por um valor longo e aleatório.
JWT_SECRET="financeflow_super_secret_key_dev"

# Porta do servidor Express (opcional, padrão 3001).
PORT=3001
